{
  "name": "acquisitions",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "imports": {
    "#src/*": "./src/*",
    "#config/*": "./src/config/*",
    "#controllers/*": "./src/controllers/*",
    "#middleware/*": "./src/middleware/*",
    "#models/*": "./src/models/*",
    "#rate-limit/*": "./src/rate-limit/*",
    "#routes/*": "./src/routes/*",
    "#services/*": "./src/services/*",
    "#utils/*": "./src/utils/*",
    "#validations/*": "./src/validations/*"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev:docker": "bash ./scripts/dev.sh",
    "prod:docker": "bash ./scripts/prod.sh",
    "test": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest",
    "bench:up": "docker compose -f docker-compose.bench.yml --env-file .env.bench up -d --build",
    "bench:down": "docker compose -f docker-compose.bench.yml --env-file .env.bench down -v",
    "bench:seed": "node benchmarks/scripts/seed.mjs",
    "bench:baseline": "PHASE=v0 bash ./benchmarks/scripts/run-phase.sh",
    "bench:v1": "PHASE=v1 bash ./benchmarks/scripts/run-phase.sh",
    "bench:report": "node benchmarks/scripts/report.mjs --phase v0",
    "bench:report:v1": "node benchmarks/scripts/report.mjs --phase v1 --dir benchmarks/v1-correctness/results --out benchmarks/v1-correctness/SUMMARY.md --compare benchmarks/v0-baseline/results",
    "bench:attribute": "node benchmarks/scripts/attribute-failures.mjs",
    "bench:attribute:v1": "node benchmarks/scripts/attribute-failures.mjs --dir benchmarks/v1-correctness/results",
    "bench:smoke": "k6 run -e VUS=10 -e DURATION=20s -e RAMP_UP=5s -e RAMP_DOWN=5s -e RUN_TAG=smoke benchmarks/k6/realistic.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idkmanan/acquisitions.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/idkmanan/acquisitions/issues"
  },
  "homepage": "https://github.com/idkmanan/acquisitions#readme",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2"
  }
}
