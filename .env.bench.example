# =============================================================================
# .env.bench.example — copy to .env.bench and fill in.
#   cp .env.bench.example .env.bench
# =============================================================================
# .env.bench is gitignored. This template is committed so the benchmark is
# reproducible by anyone who clones the repo.
# =============================================================================

# --- Application ---------------------------------------------------------
# MUST be 'development'. Not a mistake, and not laziness:
# src/config/database.js:8 gates the pg.Pool construction on this exact string.
# Any other value silently switches to the Neon HTTP driver, which cannot reach
# the local Postgres container. Phase 3 deletes that branch and this note with it.
NODE_ENV=development
PORT=3000

# 'warn' during benchmarks. At 'info' the app writes a winston line per request
# (src/app.js:18) plus a morgan line, and synchronous file I/O to logs/ becomes a
# confound in the p99. Phase 0 measures the app, not the disk.
LOG_LEVEL=warn

# --- Auth ----------------------------------------------------------------
# Local-only throwaway values. Generate real ones with: openssl rand -base64 32
JWT_SECRET=bench-only-not-a-real-secret-change-me
COOKIE_SECRET=bench-only-not-a-real-secret-change-me

# --- Postgres ------------------------------------------------------------
POSTGRES_USER=bench
POSTGRES_PASSWORD=bench
POSTGRES_DB=benchdb
PG_HOST_PORT=5433

# --- Resource pinning ----------------------------------------------------
# Pinned so results are comparable across machines and across phases.
# Record any change to these in PROJECT_LIFECYCLE.md — altering them
# invalidates comparison with previously committed runs.
APP_CPUS=1.0
APP_MEMORY=512M
PG_CPUS=1.0
PG_MEMORY=1G
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=256MB
PG_WORK_MEM=8MB
PG_EFFECTIVE_CACHE_SIZE=768MB

# --- Arcjet --------------------------------------------------------------
# Leave EMPTY for the baseline. With no key, aj.protect() returns an ERROR
# decision, which src/middleware/security.middleware.js treats as "allow" —
# verified, and documented as finding F-07. That fail-open behaviour is what
# makes an unkeyed baseline run possible at all.
ARCJET_KEY=

# Measurement control added in Phase 0. See BENCHMARKING.md.
#   BENCH_BYPASS_SECURITY=0  -> as-built: Arcjet middleware in the request path
#   BENCH_BYPASS_SECURITY=1  -> control:  middleware skipped, isolates app+DB cost
# Only honoured when NODE_ENV !== 'production'. Never set this in a real deploy.
BENCH_BYPASS_SECURITY=0

# --- CORS ----------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000
