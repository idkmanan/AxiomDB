# =============================================================================
# .env.bench.example — copy to .env.bench and fill in.
#   cp .env.bench.example .env.bench
# =============================================================================
# .env.bench is gitignored. This template is committed so the benchmark is
# reproducible by anyone who clones the repo.
# =============================================================================

# --- Application ---------------------------------------------------------
# MUST be 'development'. Not a mistake, and not laziness:
# src/config/database.js gates the pg.Pool construction on this exact string.
# Any other value silently switches to the Neon HTTP driver, which cannot reach
# the local Postgres container. Phase 3 deletes that branch and this note with it.
NODE_ENV=development
PORT=3000

# 'warn' during benchmarks. At 'info' the app writes one structured line per
# request (src/middleware/request-log.middleware.js) and synchronous file I/O to
# logs/ becomes a confound in the p99. The benchmark measures the app, not the disk.
LOG_LEVEL=warn

# --- Auth ----------------------------------------------------------------
# Local-only throwaway values. Generate real ones with: openssl rand -base64 32
# Must be >= 32 characters: src/config/env.js throws on a short secret in
# production and warns elsewhere.
JWT_SECRET=bench-only-not-a-real-secret-change-me-0123456789

# Access-token and cookie lifetime in ms — ONE value, two consumers
# (src/utils/jwt.js and src/utils/cookies.js). v0 had 15 minutes in one and '1d' in
# the other. Raised above the 15-minute default here only so a long matrix cannot
# expire the admin token k6 obtains once in setup(); see benchmarks/k6/lib/journey.js.
SESSION_TTL_MS=3600000

# --- Postgres ------------------------------------------------------------
POSTGRES_USER=bench
POSTGRES_PASSWORD=bench
POSTGRES_DB=benchdb
PG_HOST_PORT=5433

# Connection pool (finding F-15). v0 left these to node-postgres defaults: max=10
# against a server configured for 200 connections, and connectionTimeoutMillis=0,
# which means "wait forever for a free slot" rather than "no timeout". Both are now
# explicit. Changing them changes what is being measured — record it in
# PROJECT_LIFECYCLE.md.
PG_POOL_MAX=20
PG_POOL_CONNECTION_TIMEOUT_MS=5000
PG_POOL_IDLE_TIMEOUT_MS=30000

# Pre-warm, added in Phase 3 (finding F-39). This is a MEASUREMENT-AFFECTING setting:
# it moves connection establishment out of the request path, which is precisely the
# cost F-37's connect timeouts were made of. Set to half of PG_POOL_MAX. If a v3 run
# is compared against v1, this is one of the changes being attributed.
PG_POOL_PREWARM=10

# Backstops. 15s is far above any query in the benchmark mix — deep OFFSET at 1M rows
# is tens of milliseconds — so a statement timeout firing during a run means something
# is wrong, not that the limit is tight. Left generous on purpose: a timeout that trips
# under normal load would censor the slow tail that the benchmark exists to measure.
PG_STATEMENT_TIMEOUT_MS=15000
PG_QUERY_TIMEOUT_MS=20000

# --- Redis and Kafka (phases 4 and 5) ------------------------------------
# REDIS_URL, KAFKA_BROKERS and RATE_LIMIT_STORE are set in docker-compose.bench.yml
# rather than here, deliberately: they are addresses on the compose network, so a value
# in this file would be wrong for anything run from the host. What matters for the run is
# that RATE_LIMIT_STORE=redis — with `memory`, three replicas would each enforce the full
# limit locally and the measured system would not be the one being claimed.
#
# The host-facing ports, for the proof scripts and drills:
#   Redis  localhost:6380   (REDIS_HOST_PORT)
#   Kafka  localhost:29092  (KAFKA_HOST_PORT)
REDIS_MAXMEMORY=256mb
REDIS_CPUS=0.5
REDIS_MEMORY=384M
KAFKA_CPUS=1.0
KAFKA_MEMORY=1G
PUBLISHER_CPUS=0.5
PUBLISHER_MEMORY=256M
CONSUMER_CPUS=0.5
CONSUMER_MEMORY=256M

# Refresh tokens. Longer than a benchmark run by a wide margin, so no VU is ever handed a
# 401 because its session aged out mid-level.
REFRESH_TTL_MS=2592000000

# --- Pagination ----------------------------------------------------------
# Replaces the unbounded SELECT that shipped 1001 rows and 167 KiB per response.
# The frozen k6 script calls GET /api/users with no query string, so this default is
# what the v0-vs-v1 comparison actually measures. Do not change it between phases.
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# --- Rate limiting -------------------------------------------------------
# RAISED FOR LOAD TESTING, AND THIS IS THE IMPORTANT NOTE IN THIS FILE.
#
# The limiter replaced Arcjet and runs in-process on every request, keyed by IP for
# the auth endpoints and by user id for authenticated reads. Every k6 VU shares one
# source IP and one admin user, so production-shaped limits would reject most of the
# matrix — and rejections are fast, so the report would show a large latency
# "improvement" that was really the limiter refusing to work.
#
# That is exactly the trap Phase 0 recorded as the F-16 corollary: supplying a
# working Arcjet key would not have improved those runs, it would have ended them.
#
# So the ceilings are raised far above what the matrix can generate. The limiter
# still executes on every request, so its CPU cost is still in the measurement —
# only the rejection is taken out of the way. run-phase.sh reads these back out of
# the running container and refuses to start if they are too low, then asserts after
# each run that zero requests were actually rejected.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=100000
RATE_LIMIT_USER_MAX=10000000
RATE_LIMIT_ADMIN_MAX=10000000

# --- Shutdown ------------------------------------------------------------
# Kept short for benchmarking: run-phase.sh recreates the app container between
# runs, and a long drain adds dead time to every one of them.
SHUTDOWN_DRAIN_TIMEOUT_MS=5000
SHUTDOWN_READINESS_DELAY_MS=0

# --- Resource pinning ----------------------------------------------------
# Pinned so results are comparable across machines and across phases.
# Record any change to these in PROJECT_LIFECYCLE.md — altering them
# invalidates comparison with previously committed runs.
APP_CPUS=1.0
APP_MEMORY=512M
PG_CPUS=1.0
PG_MEMORY=1G
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=256MB
PG_WORK_MEM=8MB
PG_EFFECTIVE_CACHE_SIZE=768MB

# --- CORS ----------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000

# --- Removed in Phase 1 --------------------------------------------------
# ARCJET_KEY and BENCH_BYPASS_SECURITY are both gone.
#
# ARCJET_KEY was deliberately left empty for the v0 baseline, which turned out to
# mean the middleware enforced nothing at all: zero rejections across fourteen runs
# against a configured 5 req/min window, because an unreachable provider returns an
# ERROR decision and the middleware only ever checked isDenied() (F-07, F-16).
#
# BENCH_BYPASS_SECURITY existed to measure with and without that middleware, since a
# third-party dependency in the request path would otherwise have been attributed to
# application code. The replacement limiter is ours, so there is nothing to
# attribute away — and no reason to keep a switch whose only function is to disable
# security.
