.env.local
.env.development.local
.env.production.local
.env.test.local

# Build outputs
dist
build
*.tsbuildinfo

# IDE/Editor
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Logs
logs
*.log
npm-debug.log*

# Test coverage
coverage
.nyc_output

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation
README.md
CHANGELOG.md
*.md
!README.md

# TypeScript cache
*.tsbuildinfo

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# Misc
*.pem
.vercel
.netlify