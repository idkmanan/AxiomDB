# =============================================================================
# .env.example — the committed template. Copy it, do not edit it in place.
#
#   cp .env.example .env.development
# =============================================================================
# Every value here is either a safe default or empty. `.gitignore` excludes
# `.env.*` and then re-includes this file and `.env.bench.example` by negation, so
# a real secret cannot be committed by accident — and the template a new
# contributor needs is still available (finding F-03).
# =============================================================================

# --- Server --------------------------------------------------------------
PORT=3000
# 'development' selects the node-postgres pool in src/config/database.js. Any other
# value routes through the Neon HTTP driver, which has no pooling, no transactions
# and no isolation levels. Phase 3 removes that branch.
NODE_ENV=development
LOG_LEVEL=info

# --- Database ------------------------------------------------------------
# From the HOST:      postgres://neon:npg@localhost:5432/neondb?sslmode=disable
# From a CONTAINER:   postgres://neon:npg@postgres:5432/neondb?sslmode=disable
#
# The two differ and it matters: `postgres` is a compose service hostname that does
# not resolve on the host. `scripts/dev.sh` runs migrations inside the compose
# network for exactly this reason — see the note at the top of that file.
DATABASE_URL=

# --- Auth ----------------------------------------------------------------
# REQUIRED, minimum 32 characters. src/config/env.js THROWS at startup if this is
# missing or short and NODE_ENV=production, and warns loudly otherwise. v0 fell
# back to a literal secret committed in this repository, so a deploy that forgot
# this variable started normally and signed forgeable tokens.
#   openssl rand -base64 32
JWT_SECRET=

# COOKIE_SECRET is deliberately NOT here. v0 required it in three templates and in
# scripts/prod.sh while nothing in src/ read it: `cookieParser()` is constructed with
# no secret, so no cookie is signed and none needs to be — the session cookie holds a
# JWT, which already carries its own signature. A variable that must be set and does
# nothing teaches people that the setup checklist is noise, which is how the entries
# that DO matter get skipped.

# Session lifetime in ms — ONE value shared by the JWT expiry and the cookie
# maxAge. v0 set 15 minutes on the cookie and '1d' on the token, so the browser
# discarded a cookie that stayed cryptographically valid for another 23h45m.
# Default is 15 minutes. There is no refresh token yet: Phase 4 adds opaque refresh
# tokens in Redis with rotation and reuse detection, so until then a session really
# does end after this interval.
# SESSION_TTL_MS=900000

# --- Rate limiting -------------------------------------------------------
# Requests per window. Defaults are production-shaped and usually need no change.
# The auth limit is per IP and deliberately tight: bcrypt at cost 10 measures
# ~55 ms per compare, so unthrottled sign-in attempts are both a credential-stuffing
# channel and the cheapest way to exhaust one core.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_USER_MAX=100
# RATE_LIMIT_ADMIN_MAX=300

# --- Connection pool -----------------------------------------------------
# v0 constructed `new Pool({ connectionString })` and inherited node-postgres
# defaults: max=10, and connectionTimeoutMillis=0 meaning "queue forever" rather
# than "no timeout" (finding F-15).
# PG_POOL_MAX=20
# PG_POOL_CONNECTION_TIMEOUT_MS=5000
# PG_POOL_IDLE_TIMEOUT_MS=30000

# --- Pagination ----------------------------------------------------------
# GET /api/users is paginated. `maxLimit` is the security-relevant one: without a
# cap, `?limit=1000000` is a caller-controlled denial of service.
# PAGINATION_DEFAULT_LIMIT=20
# PAGINATION_MAX_LIMIT=100

# --- Graceful shutdown ---------------------------------------------------
# On SIGTERM the app fails readiness, waits for the load balancer to notice, then
# drains in-flight requests. Keep the total below your orchestrator's grace period
# (Compose `stop_grace_period`, Kubernetes `terminationGracePeriodSeconds`) or it is
# killed mid-drain and the sequence never completes.
# SHUTDOWN_READINESS_DELAY_MS=2000
# SHUTDOWN_DRAIN_TIMEOUT_MS=10000

# --- Proxy ---------------------------------------------------------------
# UNSET by default, and that default is the safe one. With `trust proxy` enabled and
# no trusted proxy actually in front, any client can spoof X-Forwarded-For and mint
# itself unlimited rate-limit buckets. Set this only once a known ingress terminates
# traffic (Phase 7).
# TRUST_PROXY=

# --- Debugging -----------------------------------------------------------
# Adds error name/code/stack to HTTP error responses. Ignored when
# NODE_ENV=production — it cannot be switched on there.
# EXPOSE_ERROR_DETAILS=false

# --- CORS ----------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000
